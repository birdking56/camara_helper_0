#-----------------------------------------------------------------------------
# 2. DDR3 PHY placement attributes
#-----------------------------------------------------------------------------
define_attribute {i:u_ddr3_test_h.u_ddrphy_top.u_ddrphy_cpd} {PAP_LOC} {DDRPHY_CPD_369_466}
define_attribute {i:u_ddr3_test_h.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[0]} {PAP_LOC} {CLMA_357_354:FF3}
define_attribute {i:u_ddr3_test_h.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[1]} {PAP_LOC} {CLMA_357_660:FF3}

#-----------------------------------------------------------------------------
# 3. Input clocks
#-----------------------------------------------------------------------------
create_clock -name {sys_clk} [get_ports {sys_clk}] -period {37.000} -waveform {0.000 18.500}
create_clock -name {ref_clk} [get_ports {clk_p}] -period {8.0} -waveform {0 4.0}
create_clock -name {pixclk_in} [get_ports {pixclk_in}] -period {6.734} -waveform {0.000 3.367}

#-----------------------------------------------------------------------------
# 4. DDR3 internal generated clocks and their groups
#-----------------------------------------------------------------------------
create_generated_clock -name {rst_clk} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {clk_p}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_test_h.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_groups -name sys_clk -asynchronous -group [get_clocks {sys_clk}]
set_clock_groups -name ref_clk -asynchronous -group [get_clocks {ref_clk}]
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
set_clock_groups -name ddrphy_sysclk -asynchronous -group [get_clocks {ddrphy_sysclk}]

#-----------------------------------------------------------------------------
# 5. Processing / output / configuration clocks added by dgc_top
#
#    pll_proc  u_gpll CLKOUT3 : 27 MHz * 25/3  = 225 MHz
#    pll_hdmi  u_gpll CLKOUT2 : 27 MHz * 11/2  = 148.5 MHz
#    pll_hdmi  u_gpll CLKOUT1 : 27 MHz * 55/2  = 742.5 MHz
#    pll_cfg   u_gpll CLKOUT0 : 27 MHz * 10/27 = 10 MHz
#-----------------------------------------------------------------------------
create_generated_clock -name {proc_clk} -source [get_ports {sys_clk}] [get_pins {u_clock_reset/u_pll_proc/u_gpll/CLKOUT3}] -master_clock [get_clocks {sys_clk}] -multiply_by {25} -divide_by {3}
create_generated_clock -name {vout_clk} -source [get_ports {sys_clk}] [get_pins {u_clock_reset/u_pll_hdmi/u_gpll/CLKOUT2}] -master_clock [get_clocks {sys_clk}] -multiply_by {11} -divide_by {2}
create_generated_clock -name {vout_clk_5x} -source [get_ports {sys_clk}] [get_pins {u_clock_reset/u_pll_hdmi/u_gpll/CLKOUT1}] -master_clock [get_clocks {sys_clk}] -multiply_by {55} -divide_by {2}
create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_pins {u_clock_reset/u_pll_cfg/u_gpll/CLKOUT0}] -master_clock [get_clocks {sys_clk}] -multiply_by {10} -divide_by {27}

#-----------------------------------------------------------------------------
# 6. Clock domain relationships
#
#    Each generated clock gets its own asynchronous group together with
#    the domain it talks to. This declares which crossings are asynchronous;
#    it does NOT hide the paths inside a domain.
#-----------------------------------------------------------------------------
set_clock_groups -name proc_clk -asynchronous -group [get_clocks {proc_clk}]
set_clock_groups -name vout_clk -asynchronous -group [get_clocks {vout_clk}]
set_clock_groups -name vout_clk_5x -asynchronous -group [get_clocks {vout_clk_5x}]

#-----------------------------------------------------------------------------
# 7. Cross-domain descriptor mailboxes (bundled data)
#
#    The toggle bit is double-registered inside dgc_mailbox; the payload is
#    held stable by the source until the acknowledge returns. The payload bus
#    therefore needs a bounded skew against its toggle, not a false path.
#    1.5 ns is one quarter of the 6.7 ns input pixel period and covers the
#    bussed-data window; tighten it after the first timing report.
#-----------------------------------------------------------------------------
# At S0 no mailbox is instantiated in dgc_top, so the constraints below are
# emitted as a template: a get_pins pattern that matches nothing is a PDS
# error. Enable the line for each mailbox as it is added in S2/S4 and
# replace <inst> with the real hierarchical instance name.
#
# set_max_delay 1.5 -from [get_pins {<inst>/payload_q[*]}] -to [get_pins {<inst>/dst_payload_q[*]}]
#
# Planned mailbox instances and their owners:
#   u_fetch_row_mbox    fetch_planner (proc) -> ddr_fetch (ddr)
#   u_frame_grant_mbox  frame_manager (ddr) -> capture_writer (vin)
#   u_frame_acq_mbox    frame_manager (ddr) -> tile_scheduler (proc)
#   u_frame_rel_mbox    tile_scheduler (proc) -> frame_manager (ddr)
#   u_stripe_offer_mbox stripe_writer (proc) -> video_reader (vout)
#   u_stripe_rel_mbox   video_reader (vout) -> stripe_writer (proc)
#
# The payload is bundled with its toggle. The toggle path itself is a
# two-flop synchroniser and needs no max_delay; only the bus does.

#-----------------------------------------------------------------------------
# 8. HDMI input bus
#
#    The receiver launches data and DE together with pixclk_in; the FPGA
#    registers them on the I/O cell. A small input delay covers the board
#    skew. Tighten with the measured value once the first timing report is in.
#-----------------------------------------------------------------------------
